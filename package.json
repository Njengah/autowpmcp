{
  "name": "autowp-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for managing WordPress sites through the WordPress REST API.",
  "main": "./build/index.js",
  "type": "module",
  "bin": {
    "autowp": "./build/index.js"
  },
  "scripts": {
    "start": "node build/index.js",
    "test": "tsc --noEmit",
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', 0o755)\""
  },
  "keywords": [
    "mcp",
    "wordpress",
    "automation",
    "claude",
    "model-context-protocol"
  ],
  "author": "Joe Njenga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Njengah/autowpmcp.git"
  },
  "bugs": {
    "url": "https://github.com/Njengah/autowpmcp/issues"
  },
  "homepage": "https://github.com/Njengah/autowpmcp#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.16.1",
    "form-data": "^4.0.5",
    "tinify": "^1.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "files": [
    "build"
  ]
}
